#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$root"

if ! command -v 7z >/dev/null 2>&1; then
    echo "error: 7z is required (Debian package: 7zip)" >&2
    exit 1
fi

uv sync
uv run vsrepo update
.venv/bin/vsrepo install bs tivtc havsfunc vsutil

# vsrepo 2.0.0 emits a non-PEP-440 dist-info version for ZNEDI3. Repair it so
# subsequent uv commands can inspect the environment.
site=$(.venv/bin/python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
bad="$site/ZNEDI3-3bd542a.dist-info"
good="$site/ZNEDI3-0+3bd542a.dist-info"
if [ -d "$bad" ]; then
    rm -rf "$good"
    mv "$bad" "$good"
    sed -i 's/^Version: 3bd542a$/Version: 0+3bd542a/' "$good/METADATA"
fi

uv run python scripts/check-plugins.py
