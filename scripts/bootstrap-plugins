#!/bin/sh
set -eu

root=$(CDPATH= cd -- "$(dirname "$0")/.." && pwd)
cd "$root"

for command in 7z cmake git c++; do
    if ! command -v "$command" >/dev/null 2>&1; then
        echo "error: $command is required" >&2
        exit 1
    fi
done

uv sync
uv run vsrepo update
.venv/bin/vsrepo install bs tivtc havsfunc vsutil

# vsrepo 2.0.0 emits a non-PEP-440 dist-info version for ZNEDI3. Repair it so
# subsequent uv commands can inspect the environment.
site=$(.venv/bin/python -c 'import sysconfig; print(sysconfig.get_paths()["purelib"])')
bad="$site/ZNEDI3-3bd542a.dist-info"
good="$site/ZNEDI3-0+3bd542a.dist-info"
if [ -d "$bad" ]; then
    rm -rf "$good"
    mv "$bad" "$good"
    sed -i 's/^Version: 3bd542a$/Version: 0+3bd542a/' "$good/METADATA"
fi

if ! .venv/bin/python -c 'import vapoursynth as vs; vs.core.neo_f3kdb' 2>/dev/null; then
    work=$(mktemp -d)
    trap 'rm -rf "$work"' EXIT HUP INT TERM
    git -C "$work" init -q
    git -C "$work" remote add origin \
        https://github.com/HomeOfAviSynthPlusEvolution/neo_f3kdb.git
    git -C "$work" fetch -q --depth 1 origin \
        4a88cc85e23a18acf22c03a5531e51d6e927986f
    git -C "$work" checkout -q FETCH_HEAD
    cmake -S "$work" -B "$work/build" \
        -DENABLE_PAR=OFF -DCMAKE_BUILD_TYPE=Release
    cmake --build "$work/build" --parallel
    plugin_dir="$site/vapoursynth/plugins"
    mkdir -p "$plugin_dir"
    cp "$work/build/libneo-f3kdb.so" "$plugin_dir/neo-f3kdb.so"
    rm -rf "$work"
    trap - EXIT HUP INT TERM
fi

uv run python scripts/check-plugins.py
